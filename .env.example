# ── Binance API ─────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_DEFAULT_RECV_WINDOW=5000

# ── Order execution ──────────────────────────────────────────
BINANCE_ORDER_ENABLED=false

# ── Auto trader ──────────────────────────────────────────────
AUTO_TRADE_ENABLED=false
AUTO_TRADE_DRY_RUN=true
AUTO_TRADE_THRESHOLD=0.7
AUTO_TRADE_MARGIN_USDT=2
AUTO_TRADE_LEVERAGE=10
AUTO_TRADE_INTERVAL_MS=15000
AUTO_TRADE_COOLDOWN_MS=900000
AUTO_TRADE_MAX_ORDERS_PER_SCAN=1
AUTO_TRADE_MAX_POSITIONS=0
AUTO_TRADE_TP_ROE=20
AUTO_TRADE_LONG_TP_ROE=20
AUTO_TRADE_SHORT_TP_ROE=15
AUTO_TRADE_LONG_SL_ROE=
AUTO_TRADE_SHORT_SL_ROE=
AUTO_TP_SCAN_ENABLED=true
AUTO_TP_SCAN_INTERVAL_MS=60000
AUTO_TRADE_STRONG_SCORE=0.85
AUTO_TRADE_STRONG_TP_MULT=1.5

# Filter: bỏ token delist / low-liquidity / đã move quá mạnh
AUTO_TRADE_MIN_VOLUME_USDT=5000000
AUTO_TRADE_MAX_CHANGE_PCT=30
AUTO_TRADE_BLACKLIST=

# Entry quality: streak confirmation + bounce entry
AUTO_TRADE_MIN_STREAK=2

# ── Averaging down (server-side, triggered by position monitor) ──
AVG_DOWN_ENABLED=false
AVG_DOWN_ROE=-60
AVG_DOWN_MARGIN_USDT=2

# ── Discord notifications ─────────────────────────────────────
DISCORD_WEBHOOK_URL=
DISCORD_SIGNAL_THRESHOLD=0.7
DISCORD_COOLDOWN_MS=3600000
DISCORD_INTERVAL_MS=30000
SPIKE_REVERSAL_WEBHOOK_URL=
SPIKE_REVERSAL_MIN_DISCORD_SCORE=0
POST_PUMP_KILL_SHORT_WEBHOOK_URL=
POST_PUMP_KILL_SHORT_MIN_DISCORD_SCORE=60
POST_PUMP_KILL_SHORT_SEND_WATCH=false
POST_PUMP_KILL_SHORT_AUTO_ORDER_ENABLED=false
POST_PUMP_KILL_SHORT_AUTO_MIN_SCORE=0
POST_PUMP_KILL_SHORT_AUTO_MARGIN_USDT=1
POST_PUMP_KILL_SHORT_AUTO_LEVERAGE=10
POST_PUMP_KILL_SHORT_AUTO_ORDER_TYPE=MARKET
POST_PUMP_KILL_SHORT_AUTO_COOLDOWN_MS=14400000
POST_PUMP_KILL_SHORT_AUTO_MAX_POSITIONS=0
MA60_5M_WARMUP_MAX_SYMBOLS=20
KLINE_AUTO_RESEED_ENABLED=false
KLINE_WARMUP_RETRY_MIN_CACHED=20
KLINE_WARMUP_RETRY_MS=90000
KLINE_START_LOGIC_MIN_READY=400
KLINE_START_LOGIC_MIN_READY_BARS=40
KLINE_START_LOGIC_TIMEOUT_MS=1200000
LONG_SHORT_REFRESH_ENABLED=true
LONG_SHORT_REFRESH_MAX_SYMBOLS=15
LONG_SHORT_REFRESH_INTERVAL_MS=900000
POST_PUMP_DUMP_RISK_AUTO_ORDER_ENABLED=false
POST_PUMP_DUMP_RISK_AUTO_MIN_SCORE=62
POST_PUMP_DUMP_RISK_AUTO_MARGIN_USDT=1
POST_PUMP_DUMP_RISK_AUTO_LEVERAGE=10
POST_PUMP_DUMP_RISK_AUTO_ORDER_TYPE=MARKET
POST_PUMP_DUMP_RISK_AUTO_COOLDOWN_MS=14400000
POST_PUMP_DUMP_RISK_AUTO_MAX_POSITIONS=0
POST_PUMP_DUMP_RISK_WEBHOOK_URL=
POST_PUMP_DUMP_RISK_MIN_DISCORD_SCORE=0
POST_PUMP_DUMP_RISK_DISCORD_COOLDOWN_MS=14400000
POST_DUMP_BOUNCE_RISK_AUTO_ORDER_ENABLED=false
POST_DUMP_BOUNCE_RISK_AUTO_MIN_SCORE=66
POST_DUMP_BOUNCE_RISK_AUTO_MARGIN_USDT=1
POST_DUMP_BOUNCE_RISK_AUTO_LEVERAGE=10
POST_DUMP_BOUNCE_RISK_AUTO_ORDER_TYPE=MARKET
POST_DUMP_BOUNCE_RISK_AUTO_COOLDOWN_MS=14400000
POST_DUMP_BOUNCE_RISK_AUTO_MAX_POSITIONS=0
POST_DUMP_BOUNCE_RISK_WEBHOOK_URL=
POST_DUMP_BOUNCE_RISK_MIN_DISCORD_SCORE=0
POST_DUMP_BOUNCE_RISK_DISCORD_COOLDOWN_MS=14400000

# ── Liquidity scan Discord alerts ────────────────────────────
LIQ_SCAN_WEBHOOK_URL=
# Webhook riêng nhận alert khi sweepProb >= 80% (để trống = không gửi)
LIQ_HIGH_PROB_WEBHOOK_URL=
LIQ_SCAN_BIAS_THRESHOLD=0.4
LIQ_SCAN_INTERVAL_MS=60000
LIQ_SCAN_COOLDOWN_MS=7200000
LIQ_SCAN_MIN_VOLUME=5000000
LIQ_SCAN_MAX_COINS=200
LIQ_TOP_TRADER_RATIO_LIMIT=50
LIQ_TOP_TRADER_TREND_THRESHOLD=0.003

# ── Auto order khi LIQ IMBALANCE sweep probability cao ───────────────────────
# Khi sweepProb >= MIN_PROB: đặt LIMIT short/long tại sweep target
AUTO_LIQ_ORDER_ENABLED=false
AUTO_LIQ_ORDER_MIN_PROB=90
AUTO_LIQ_ORDER_MARGIN=2
AUTO_LIQ_ORDER_LEVERAGE=10
AUTO_LIQ_CONFIRMED_ORDER_TYPE=MARKET
# false = chỉ đánh dấu ENTRY_READY, bấm nút trên /paper mới đặt Binance MARKET.
AUTO_LIQ_AUTO_MARKET_ON_CONFIRMATION=false
# true = chỉ coi lệnh là confirmed sau khi giá quét target rồi có nến rejection.
AUTO_LIQ_REQUIRE_REVERSAL_CONFIRMATION=true
# true = trước khi có confirmation vẫn đặt probe nhỏ để test thanh khoản.
AUTO_LIQ_PROBE_BEFORE_CONFIRMATION=true
AUTO_LIQ_PROBE_MARGIN=1
AUTO_LIQ_REJECTION_PCT=0.002
AUTO_LIQ_MIN_WICK_PCT=0.003
# Paper trade ảo cho tín hiệu LIQ IMBALANCE xác suất cao.
PAPER_LIQ_ENABLED=true
PAPER_LIQ_MIN_PROB=70
PAPER_LIQ_MARGIN=1
PAPER_LIQ_LEVERAGE=10
PAPER_BINANCE_MARKET_MARGIN=2
PAPER_TRADE_TICKER_ENABLED=true
# Tối đa bao nhiêu lệnh LIMIT entry chờ cùng lúc (0 = không giới hạn)
AUTO_LIQ_MAX_LIMIT_ORDERS=30

# ── Volume Dump scanner (vol cao liên tiếp + sập mạnh → short) ────────────────
# Để trống = dùng LIQ_SCAN_WEBHOOK_URL
VOL_DUMP_WEBHOOK_URL=
# Cảnh báo nến xả/tăng mạnh (body >= BIG_CANDLE_DROP_PCT%)
BIG_CANDLE_WEBHOOK_URL=
BIG_CANDLE_DROP_PCT=8
VOL_DUMP_INTERVAL_MS=60000
VOL_DUMP_COOLDOWN_MS=7200000
VOL_DUMP_MIN_VOLUME=5000000
VOL_DUMP_MAX_COINS=150
# Hệ số volume để coi là "cao" (1.8 = 80% trên trung bình)
VOL_DUMP_VOL_MULT=1.8
# Tối thiểu bao nhiêu nến liên tiếp phải cao volume
VOL_DUMP_SUSTAINED=3
# % sụt thân nến cuối cùng (âm)
VOL_DUMP_DROP_PCT=1.5
# % sụt giá 4 nến gần nhất (âm)
VOL_DUMP_MOVE4C_PCT=2.5

# ── Orders UI password ────────────────────────────────────────
ORDERS_PASSWORD=

# ── Liquidity base URL (Discord embed links) ──────────────────
LIQUIDITY_BASE_URL=https://liquidity.nhathadev.trade

# ── Trailing stop (TSL) ───────────────────────────────────────
TRAILING_STOP_ENABLED=false
TRAILING_STOP_TRIGGER_ROE=10
TRAILING_STOP_UPDATE_ROE=5
# SL ladder: 10% ROE → khóa 1%, 15% → 5%, 20% → 10%, 25% → 15%
TRAILING_STOP_BUFFER_ROE=10
TRAILING_STOP_INTERVAL_MS=30000
SL_TRAIL_SAFETY_SCAN_ENABLED=true
SL_TRAIL_SAFETY_SCAN_INTERVAL_MS=30000
# Webhook nhận thông báo TSL: đặt SL, dời SL, WS connected
TSL_WEBHOOK_URL=

# ── TP entry guard: dời TP về entry khi ROE ≤ ngưỡng ─────────
TP_ENTRY_GUARD_ROE=-50

# ── Auto SL: tự đặt SL khi khớp lệnh mới (event-driven) ─────
AUTO_SL_ENABLED=true
# ROE loss % để đặt SL (dương = lỗ bao nhiêu % thì cắt)
AUTO_SL_ROE=25

# ── Negative TP timeout: dời TP về entry nếu âm liên tục ─────
# Thời gian (ms) ROE âm liên tục trước khi đặt TP = entry
# ROE âm vượt ngưỡng này → đặt TP về entry ngay (không chờ timeout)
NEG_TP_ROE=-30
NEG_TP_TIMEOUT_MS=14400000

# ── Pump Signal auto LIMIT order ─────────────────────────────
# Tự động đặt LIMIT khi pump signal score >= 85, marketOk=true, emaRibbon bull
# Yêu cầu: đăng nhập /orders với Binance API key trước khi bật
PUMP_AUTO_ORDER_ENABLED=false
# Margin mỗi lệnh ($)
PUMP_AUTO_ORDER_MARGIN=1
# Đòn bẩy (notional = margin × leverage)
PUMP_AUTO_ORDER_LEVERAGE=10

# ── OpenAI (AI Analysis trên detail page) ────────────────────
# Lấy key tại platform.openai.com → API keys (khác với ChatGPT Plus)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

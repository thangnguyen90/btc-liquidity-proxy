# ── Binance API ─────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_DEFAULT_RECV_WINDOW=5000

# ── Order execution ──────────────────────────────────────────
BINANCE_ORDER_ENABLED=false

# ── Auto trader ──────────────────────────────────────────────
AUTO_TRADE_ENABLED=false
AUTO_TRADE_DRY_RUN=true
AUTO_TRADE_THRESHOLD=0.7
AUTO_TRADE_MARGIN_USDT=2
AUTO_TRADE_LEVERAGE=10
AUTO_TRADE_INTERVAL_MS=15000
AUTO_TRADE_COOLDOWN_MS=900000
AUTO_TRADE_MAX_ORDERS_PER_SCAN=1
AUTO_TRADE_TP_ROE=20

# Filter: bỏ token delist / low-liquidity / đã move quá mạnh
AUTO_TRADE_MIN_VOLUME_USDT=5000000
AUTO_TRADE_MAX_CHANGE_PCT=30
AUTO_TRADE_BLACKLIST=

# Entry quality: streak confirmation + bounce entry
AUTO_TRADE_MIN_STREAK=2

# ── Averaging down: configured via Orders UI (localStorage) ──

# ── Discord notifications ─────────────────────────────────────
DISCORD_WEBHOOK_URL=
DISCORD_SIGNAL_THRESHOLD=0.7
DISCORD_COOLDOWN_MS=3600000
DISCORD_INTERVAL_MS=30000

# ── Trailing stop (TSL) ───────────────────────────────────────
TRAILING_STOP_ENABLED=false
TRAILING_STOP_TRIGGER_ROE=1
TRAILING_STOP_LOCK_MARGIN_PCT=1
TRAILING_STOP_INTERVAL_MS=30000

# ── TP entry guard: dời TP về entry khi ROE ≤ ngưỡng ─────────
TP_ENTRY_GUARD_ROE=-50

# Live-card SHORT entry guard. Gia hien tai thap hon signal entry la truot bat loi cho SHORT.
# Moi rule dung MARKET ngay khi pass; vuot nguong thi bo lenh, khong cho retest.
# DAY_BEAR_CONTINUE luon observe-only va khong duoc tu cap lenh that.
LIVE_CARD_SHORT_FIT_MARGIN_USDT=3
LIVE_CARD_SHORT_FIT_MAX_ADVERSE_SLIPPAGE_PCT=0.1

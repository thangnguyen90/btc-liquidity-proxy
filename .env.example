# Exact rank=3 colored transition on /btc-session-watch; OBSERVE ONLY, never places Binance orders.
BTC_SESSION_WATCH_DISCORD_WEBHOOK_URL=
# Coin strength opposite BTC: notify once near the dynamic zone and once after 5m confirmation.
# Observe only: never creates or modifies Binance orders.
BTC_RELATIVE_STRENGTH_DISCORD_WEBHOOK_URL=
BTC_RELATIVE_STRENGTH_DISCORD_MAX_PER_SCAN=5

# AI Local PRIORITY/WATCH + sudden BTC direction-change feed. AI/Discord remain
# analytical; a separate Auto Controls route may MARKET 3 USDT margin x5 only
# when a PRIORITY candidate's live MARK enters its deterministic engine zone.
LOCAL_AI_TREND_DISCORD_WEBHOOK_URL=
LOCAL_AI_TREND_AUTO_EVALUATE_MS=600000
LOCAL_AI_TREND_AUTO_START_DELAY_MS=120000
LOCAL_AI_TREND_TIMEOUT_MS=180000
# CPU-safe Top 10 profile for qwen3:8b. Increase only after measuring real latency.
LOCAL_AI_TREND_NUM_CTX=4096
LOCAL_AI_TREND_NUM_PREDICT=384
LOCAL_AI_TREND_NUM_BATCH=128
LOCAL_AI_TREND_DISCORD_BTC_POLL_MS=30000
LOCAL_AI_TREND_DISCORD_SIGNAL_COOLDOWN_MS=1800000
LOCAL_AI_TREND_DISCORD_BTC_COOLDOWN_MS=900000
LOCAL_AI_TREND_DISCORD_BTC_15M_PCT=0.25
LOCAL_AI_TREND_DISCORD_BTC_1H_PCT=0.55
LOCAL_AI_TREND_DISCORD_MAX_PER_EVALUATION=3
LOCAL_AI_TREND_DISCORD_FORECAST_REFRESH_MS=3600000
# Retrospective AI Signal Review: send once when the 4h direction is profitable
# after cost and the original entry zone improves on immediate entry. Existing
# passes are baselined on first run to prevent a historical Discord flood.
LOCAL_AI_SIGNAL_REVIEW_DISCORD_WEBHOOK_URL=
LOCAL_AI_SIGNAL_REVIEW_DISCORD_MAX_PER_RUN=10
LOCAL_AI_SIGNAL_REVIEW_REFRESH_MS=1800000
# Same webhook also receives extreme BTC closed-candle alerts. DOWN and UP use
# symmetric absolute thresholds; repeated alerts cool down unless severity rises.
BTC_EXTREME_DISCORD_MIN_15M_PCT=0.75
BTC_EXTREME_DISCORD_MIN_1H_PCT=1.50
BTC_EXTREME_DISCORD_MIN_4H_PCT=3.00
BTC_EXTREME_DISCORD_COOLDOWN_MS=3600000
# Two-sided Binance LiqScan lifecycle: UPPER sweep+reject => SHORT WATCH;
# LOWER sweep+reclaim => LONG WATCH. Disabled by default; requires both opt-in and a dedicated webhook.
LOCAL_AI_LIQUIDITY_SWEEP_REJECT_DISCORD_ENABLED=false
LOCAL_AI_LIQUIDITY_SWEEP_REJECT_DISCORD_WEBHOOK_URL=
LOCAL_AI_LIQUIDITY_SWEEP_REJECT_DISCORD_COOLDOWN_MS=14400000
LOCAL_AI_LIQUIDITY_SWEEP_REJECT_DISCORD_MAX_PER_SCAN=5
# LiqScan MAIN KILL breakout confirmed independently by a closed 5m or 15m
# candle while the total visible Binance depth on the opposite side is larger.
# OBSERVE ONLY; each timeframe has its own dedupe/cooldown key.
LOCAL_AI_LIQUIDITY_BREAKOUT_OPPOSITE_DEPTH_DISCORD_ENABLED=false
LOCAL_AI_LIQUIDITY_BREAKOUT_OPPOSITE_DEPTH_DISCORD_WEBHOOK_URL=
LOCAL_AI_LIQUIDITY_BREAKOUT_OPPOSITE_DEPTH_DISCORD_COOLDOWN_MS=14400000
LOCAL_AI_LIQUIDITY_BREAKOUT_OPPOSITE_DEPTH_DISCORD_MAX_PER_SCAN=5
LOCAL_AI_LIQUIDITY_BREAKOUT_OPPOSITE_DEPTH_ANALYSIS_BATCH_SIZE=5
# Rebuild the read-only 5 USDT filled-order × VN-hour × BTC cache (default 6h; minimum 1h).
BTC_HOURLY_ENTRY_FORECAST_REFRESH_MS=21600000
LOCAL_AI_WINDOWS_OLLAMA_EXE=/mnt/c/Users/admin/AppData/Local/Programs/Ollama/ollama.exe
LOCAL_AI_OLLAMA_RESTART_COOLDOWN_MS=60000
# Windows llama-server orphan cleanup. The 60-second Ollama watchdog only kills
# an exact llama-server.exe PID whose recorded parent no longer exists and whose
# process age exceeds this grace period. Active Ollama children are never killed.
LOCAL_AI_OLLAMA_ORPHAN_CLEANUP_ENABLED=true
LOCAL_AI_OLLAMA_ORPHAN_MIN_AGE_MS=300000
LOCAL_AI_OLLAMA_ORPHAN_MAX_KILLS=16
LOCAL_AI_WINDOWS_POWERSHELL_EXE=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
# Dedicated `_IMPULSE` confirmation feed only: LONG NO_SELL_CONFIRMATION and
# SHORT NO_BUY_CONFIRMATION. Early impulse/late-no-chase stages are excluded.
POST_MOVE_IMPULSE_CONFIRMATION_DISCORD_WEBHOOK_URL=
POST_MOVE_IMPULSE_CANDLE_DISCORD_WEBHOOK_URL=
# The candle webhook now receives ENTRY_PASS_ONLY (retest/base continuation), not raw impulses.

# Pump-base support LONG: closed retest + confirmation + fresh MARK inside valid entry + live net R:R >=1.5.
# Observe only: this Discord route never places or modifies Binance orders.
PUMP_BASE_SUPPORT_DISCORD_WEBHOOK_URL=
PUMP_BASE_SUPPORT_DISCORD_MAX_PER_SCAN=5
# Symmetric SHORT page: closed rejection + fresh MARK inside entry + live net R:R >=1.5.
DUMP_CAP_RESISTANCE_DISCORD_WEBHOOK_URL=
DUMP_CAP_RESISTANCE_DISCORD_MAX_PER_SCAN=5

# LONG/SHORT ideal-entry zone touches from the post-dump/post-pump MTF pages; observe only.
POST_MOVE_IDEAL_ENTRY_DISCORD_WEBHOOK_URL=
POST_MOVE_IDEAL_ENTRY_DISCORD_SCAN_INTERVAL_MS=15000
POST_MOVE_IDEAL_ENTRY_DISCORD_MAX_PER_SCAN=5
# Exact same-symbol + same-timeframe LONG/SHORT post-move overlap: close an open
# Binance position at MARKET only when a fresh mark-price check still has PnL > 0 USDT.
# Fail-closed by default; enable explicitly per machine.
POST_MOVE_DUAL_DIRECTION_PROFIT_CLOSE_ENABLED=false

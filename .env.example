BINANCE_AUTH_FAILURE_BLOCK_MS=300000
# Gửi Discord sau khi ORDER_TRADE_UPDATE xác nhận fill mở/tăng vị thế thật (không gửi reduce-only close).
ORDER_FILL_WEBHOOK_URL=
# Tùy chọn webhook riêng cho lỗi card whitelist Binance; để trống sẽ dùng ORDER_FILL_WEBHOOK_URL.
LIVE_CARD_ORDER_WEBHOOK_URL=
# Tối đa bao nhiêu lệnh LIMIT entry chờ cùng lúc (0 = không giới hạn)
AUTO_LIQ_MAX_LIMIT_ORDERS=30

# ── Volume Dump scanner (vol cao liên tiếp + sập mạnh → short) ────────────────
# Để trống = dùng LIQ_SCAN_WEBHOOK_URL
VOL_DUMP_WEBHOOK_URL=
# Cảnh báo nến xả/tăng mạnh (body >= BIG_CANDLE_DROP_PCT%)
BIG_CANDLE_WEBHOOK_URL=
BIG_CANDLE_DROP_PCT=8
VOL_DUMP_INTERVAL_MS=60000
VOL_DUMP_COOLDOWN_MS=7200000
VOL_DUMP_MIN_VOLUME=5000000
VOL_DUMP_MAX_COINS=150
# Hệ số volume để coi là "cao" (1.8 = 80% trên trung bình)
VOL_DUMP_VOL_MULT=1.8
# Tối thiểu bao nhiêu nến liên tiếp phải cao volume
VOL_DUMP_SUSTAINED=3
# % sụt thân nến cuối cùng (âm)
VOL_DUMP_DROP_PCT=1.5
# % sụt giá 4 nến gần nhất (âm)

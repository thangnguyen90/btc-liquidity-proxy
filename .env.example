# ── Binance API ─────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_DEFAULT_RECV_WINDOW=5000

# HTTP listener. Use 0.0.0.0 under WSL so Windows localhost forwarding can
# reconnect cleanly after the Node service is reloaded.
HOST=0.0.0.0
PORT=19082

# Market news impact board
MARKET_NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed,https://feeds.bbci.co.uk/news/world/rss.xml,https://news.google.com/rss/search?q=(Iran%20OR%20Israel%20OR%20Hormuz%20OR%20sanctions%20OR%20oil%20OR%20Fed%20OR%20CPI)%20(crypto%20OR%20bitcoin%20OR%20markets)&hl=en-US&gl=US&ceid=US:en
MARKET_NEWS_LIMIT=120
MARKET_NEWS_REFRESH_MS=86400000
MARKET_NEWS_FETCH_TIMEOUT_MS=12000

# CoinGlass spot coin netflow board
COINGLASS_API_KEY=
COIN_FLOW_PER_PAGE=150
COIN_FLOW_REFRESH_MS=3600000
COIN_FLOW_FETCH_TIMEOUT_MS=12000

# CoinGlass Model 3 web collector độc lập với Liquid Flow V2 và paper.
COINGLASS_WEB_TOP20_ENABLED=true
COINGLASS_WEB_TOP20_LIMIT=40
COINGLASS_WEB_SCAN_LIMIT=40
COINGLASS_WEB_TOP20_TIMEOUT_MS=720000
COINGLASS_WEB_LOGIN_TIMEOUT_MS=600000
COINGLASS_WEB_BROWSER_CONCURRENCY=4
COINGLASS_WEB_SCHEDULER_ENABLED=true
COINGLASS_WEB_SCAN_INTERVAL_MS=180000
COINGLASS_WEB_BROWSER_MODE=headless
COINGLASS_WEB_CAPTURE_IMAGES=false
COINGLASS_WEB_DISABLE_GPU=true
COINGLASS_WEB_VIEWPORT_WIDTH=1280
COINGLASS_WEB_VIEWPORT_HEIGHT=900
COINGLASS_WEB_SCAN_BUDGET_MS=150000
COINGLASS_WEB_DISCORD_WEBHOOK_URL=
# Webhook riêng: mỗi lượt quét gửi đúng một đánh giá hai vùng thanh lý, không kích hoạt Binance.
COINGLASS_WEB_ZONE_EVALUATION_WEBHOOK_URL=
# Coin Level Analysis: cảnh báo một phía REJECTED/APPROACHING và setup hai phía khi có đủ cặp vùng.
# Observe only, dedupe 4h theo symbol + cặp vùng; không phát lệnh Binance.
COIN_LEVEL_LIFECYCLE_DISCORD_WEBHOOK_URL=
# Detector độc lập: CoinGlass phải có >=2 cụm mỗi phía; chỉ sau đó mới tải
# Binance 5m/15m + taker/OI/force-order cho tối đa 8 candidate. Discord only.
COINGLASS_HYBRID_LIQUIDITY_ENABLED=false
COINGLASS_HYBRID_LIQUIDITY_DISCORD_WEBHOOK_URL=
COINGLASS_HYBRID_LIQUIDITY_MAX_CANDIDATES=8
COINGLASS_HYBRID_LIQUIDITY_MAX_ZONE_DISTANCE_PCT=25
COINGLASS_HYBRID_LIQUIDITY_MIN_ZONES_PER_SIDE=2
COINGLASS_HYBRID_LIQUIDITY_MAX_SIDE_SCORE_RATIO=3
COINGLASS_HYBRID_LIQUIDITY_DISCORD_COOLDOWN_MS=14400000
# State machine riêng: chỉ vùng còn ở mép phải; APPROACHING/SWEPT chỉ cảnh báo,
# REJECTED/ACCEPTED MARKET margin $2 cho cả base, SHORT sóng mạnh và LONG target xa.
# LONG xa vẫn chia +2%/70%, tối đa +5%/30%.
# SHORT xa chia -2%/70%, tối đa -5%/30%; nếu change24h >= +10% thì -1%/80%, tối đa -3%/20%.
# Luôn x5; entry ban đầu TP-only. Runner SHORT mạnh có ngoại lệ BE sau TP1 ở cấu hình bên dưới.
COINGLASS_ZONE_LIFECYCLE_ENABLED=true
COINGLASS_ZONE_LIFECYCLE_DISCORD_WEBHOOK_URL=
COINGLASS_ZONE_LIFECYCLE_BINANCE_ENABLED=false
COINGLASS_ZONE_LIFECYCLE_MARGIN_USDT=2
COINGLASS_ZONE_LIFECYCLE_ACCEPTED_MARGIN_USDT=10
COINGLASS_ZONE_LIFECYCLE_UNCONFIRMED_BOUNCE_MARGIN_USDT=5
COINGLASS_ZONE_LIFECYCLE_TAKE_PROFIT_ROE_PCT=0
# Riêng BELOW → SWEPT → REJECTED có nến tăng, râu dưới >=20% range và close >=65% range.
COINGLASS_ZONE_LIFECYCLE_SUPPORT_RECLAIM_MARGIN_USDT=3
COINGLASS_ZONE_LIFECYCLE_STRONG_SHORT_MARGIN_USDT=2
COINGLASS_ZONE_LIFECYCLE_LARGE_TARGET_THRESHOLD_PCT=5
COINGLASS_ZONE_LIFECYCLE_LARGE_TARGET_MARGIN_USDT=2
COINGLASS_ZONE_LIFECYCLE_LONG_SINGLE_TARGET_MAX_PCT=3
COINGLASS_ZONE_LIFECYCLE_LONG_TP1_DISTANCE_PCT=2
COINGLASS_ZONE_LIFECYCLE_LONG_TP1_CLOSE_RATIO=0.7
COINGLASS_ZONE_LIFECYCLE_LONG_TP2_CAP_PCT=5
COINGLASS_ZONE_LIFECYCLE_SHORT_SINGLE_TARGET_MAX_PCT=3
COINGLASS_ZONE_LIFECYCLE_SHORT_TP1_DISTANCE_PCT=2
COINGLASS_ZONE_LIFECYCLE_SHORT_TP1_CLOSE_RATIO=0.7
COINGLASS_ZONE_LIFECYCLE_SHORT_TP2_CAP_PCT=5
COINGLASS_ZONE_LIFECYCLE_SHORT_STRONG_WAVE_CHANGE_24H_PCT=10
COINGLASS_ZONE_LIFECYCLE_SHORT_STRONG_TAKE_PROFIT_ROE_PCT=5
COINGLASS_ZONE_LIFECYCLE_SHORT_STRONG_TP1_DISTANCE_PCT=1
COINGLASS_ZONE_LIFECYCLE_SHORT_STRONG_TP1_CLOSE_RATIO=0.8
COINGLASS_ZONE_LIFECYCLE_SHORT_STRONG_TP2_CAP_PCT=3
# Chỉ runner của entry V7 STRONG_UP_WAVE: TP1 đã fill + ROE >=5% thì STOP tại average entry.
# ZKP/4 và coin |change24h| >=25% không dời BE; không MARKET-close nếu đã quay qua entry.
COINGLASS_ZONE_LIFECYCLE_STRONG_SHORT_BE_TRIGGER_ROE=5
COINGLASS_ZONE_LIFECYCLE_STRONG_SHORT_BE_EXCLUDED_SYMBOLS=ZKPUSDT,4USDT
COINGLASS_ZONE_LIFECYCLE_HYPER_VOLATILE_CHANGE_24H_PCT=25
COINGLASS_ZONE_LIFECYCLE_LEVERAGE=5
COINGLASS_ZONE_LIFECYCLE_MAX_SLIPPAGE_PCT=1.5
COINGLASS_ZONE_LIFECYCLE_MAX_POSITIONS=30
COINGLASS_ZONE_LIFECYCLE_REVERSAL_ENABLED=true
COINGLASS_ZONE_LIFECYCLE_REVERSAL_MARGIN_USDT=1
COINGLASS_WEB_SECONDARY_ZONE_LIFECYCLE_REVERSAL_MARGIN_USDT=1
COINGLASS_WEB_DISCORD_SIGNAL_COOLDOWN_MS=1800000
COINGLASS_WEB_DISCORD_AUTH_COOLDOWN_MS=3600000
COINGLASS_WEB_PUBLIC_URL=http://127.0.0.1:19082/coinglass-web-top20
COINGLASS_WEB_BINANCE_ENABLED=true
COINGLASS_WEB_BINANCE_MARGIN_USDT=5
COINGLASS_WEB_BINANCE_LEVERAGE=5
COINGLASS_WEB_BINANCE_STOP_LOSS_ROE_PCT=20
COINGLASS_WEB_BINANCE_MAX_POSITIONS=30
COINGLASS_WEB_BINANCE_DEDUPE_MS=14400000

# Luồng CoinGlass phụ: movers hạng 41-80, profile/snapshot/scheduler riêng.
# CoinGlass Qualified luôn OBSERVE ONLY; Zone Lifecycle là nhánh opt-in riêng.
# Profile phụ phải đăng nhập một lần tại /coinglass-web-secondary; không dùng chung
# browser-profile với nhóm chính để tránh Chromium profile lock.
COINGLASS_WEB_SECONDARY_ENABLED=true
COINGLASS_WEB_SECONDARY_RANK_OFFSET=40
COINGLASS_WEB_SECONDARY_LIMIT=40
COINGLASS_WEB_SECONDARY_SCHEDULER_ENABLED=true
COINGLASS_WEB_SECONDARY_SCAN_INTERVAL_MS=360000
COINGLASS_WEB_SECONDARY_INITIAL_DELAY_MS=270000
COINGLASS_WEB_SECONDARY_SCAN_BUDGET_MS=150000
COINGLASS_WEB_SECONDARY_BROWSER_CONCURRENCY=4
COINGLASS_WEB_SECONDARY_NICE_LEVEL=10
COINGLASS_WEB_SECONDARY_TIMEOUT_MS=720000
COINGLASS_WEB_SECONDARY_LOGIN_TIMEOUT_MS=600000
COINGLASS_WEB_SECONDARY_PUBLIC_URL=http://127.0.0.1:19082/coinglass-web-secondary
COINGLASS_WEB_SECONDARY_ZONE_LIFECYCLE_ENABLED=false
COINGLASS_WEB_SECONDARY_ZONE_LIFECYCLE_DISCORD_WEBHOOK_URL=
COINGLASS_WEB_SECONDARY_ZONE_LIFECYCLE_BINANCE_ENABLED=false
COINGLASS_WEB_SECONDARY_ZONE_LIFECYCLE_MARGIN_USDT=2.5
COINGLASS_WEB_SECONDARY_ZONE_LIFECYCLE_SUPPORT_RECLAIM_MARGIN_USDT=2.5
COINGLASS_WEB_SECONDARY_ZONE_LIFECYCLE_STRONG_SHORT_MARGIN_USDT=2.5
COINGLASS_WEB_SECONDARY_ZONE_LIFECYCLE_LARGE_TARGET_MARGIN_USDT=2.5
COINGLASS_WEB_SECONDARY_ZONE_LIFECYCLE_ACCEPTED_MARGIN_USDT=10
COINGLASS_WEB_SECONDARY_ZONE_LIFECYCLE_UNCONFIRMED_BOUNCE_MARGIN_USDT=5
COINGLASS_WEB_SECONDARY_ZONE_LIFECYCLE_TAKE_PROFIT_ROE_PCT=6
COINGLASS_WEB_SECONDARY_ZONE_LIFECYCLE_LEVERAGE=5
COINGLASS_WEB_SECONDARY_ZONE_LIFECYCLE_MAX_POSITIONS=30

# ── Order execution ──────────────────────────────────────────
# Token unlock board. TOKEN_UNLOCKS_API_URL can point to any JSON feed with rows/items/events/unlocks/data.
TOKEN_UNLOCKS_API_URL=
TOKEN_UNLOCKS_API_KEY=
TOKEN_UNLOCKS_REFRESH_MS=86400000
TOKEN_UNLOCKS_HORIZON_DAYS=180
TOKEN_UNLOCKS_FETCH_TIMEOUT_MS=15000

BINANCE_ORDER_ENABLED=false
# Mặc định true: chỉ card đã bật LỆNH THẬT trong Orders được auto entry Binance.
# Lệnh thủ công có session Orders và TP/SL/bot-close bảo vệ vị thế vẫn hoạt động.
LIVE_CARD_WHITELIST_ONLY_AUTO_BINANCE=true
# Live-card Binance fail-safe: SHORT only, close MARKET after 24h by default.
LIVE_CARD_SHORT_TIME_STOP_ENABLED=true
LIVE_CARD_SHORT_MAX_HOLD_MS=86400000
LIVE_CARD_SHORT_TIME_STOP_INTERVAL_MS=60000

# Giữ mọi regular LIMIT đã đặt. Chỉ bật true nếu muốn khôi phục auto-cancel theo BTC/timeout.
AUTO_CANCEL_ENTRY_LIMIT_ORDERS=false
# Chỉ có hiệu lực khi AUTO_CANCEL_ENTRY_LIMIT_ORDERS=true.
STALE_ORDER_TIMEOUT_MS=1800000
# Độc lập với BTC-bias cancellation: LIMIT entry độc lập chưa fill quá 12h sẽ bị hủy.
# LIMIT cùng chiều với position đang mở được coi là DCA_ATTACHED: miễn timeout/bias/retest và chỉ hủy khi position gốc đóng.
ENTRY_LIMIT_12H_CANCEL_ENABLED=true
ENTRY_LIMIT_MAX_AGE_MS=43200000

# ── Auto trader ──────────────────────────────────────────────
AUTO_TRADE_ENABLED=false
AUTO_TRADE_DRY_RUN=true
AUTO_TRADE_THRESHOLD=0.7
AUTO_TRADE_MARGIN_USDT=2
AUTO_TRADE_LEVERAGE=10
AUTO_TRADE_INTERVAL_MS=15000
AUTO_TRADE_COOLDOWN_MS=900000
AUTO_TRADE_MAX_ORDERS_PER_SCAN=1
AUTO_TRADE_MAX_POSITIONS=30
AUTO_TRADE_TP_ROE=20
AUTO_TRADE_LONG_TP_ROE=20
AUTO_TRADE_SHORT_TP_ROE=15
AUTO_TRADE_LONG_SL_ROE=
AUTO_TRADE_SHORT_SL_ROE=
AUTO_TP_SCAN_ENABLED=false
AUTO_TP_SCAN_INTERVAL_MS=60000
# Chay dung mot lan sau moi lan service khoi dong: chi bo sung TP con thieu.
# Khong tao/sua/huy SL va khong cancel TP/order da co.
BINANCE_STARTUP_TP_RECOVERY_ENABLED=true
BINANCE_STARTUP_TP_RECOVERY_DELAY_MS=20000
# One-shot exact full-fill replay after a process/WSL outage. This is not a
# periodic missing-protection scanner and never backfills fills older than the
# durable watermark.
BINANCE_MISSED_FILL_RECOVERY_ENABLED=true
BINANCE_MISSED_FILL_RECOVERY_DELAY_MS=12000
AUTO_TRADE_STRONG_SCORE=0.85
AUTO_TRADE_STRONG_TP_MULT=1.5

# Filter: bỏ token delist / low-liquidity / đã move quá mạnh
AUTO_TRADE_MIN_VOLUME_USDT=5000000
AUTO_TRADE_MAX_CHANGE_PCT=30
AUTO_TRADE_BLACKLIST=

# Entry quality: streak confirmation + bounce entry
AUTO_TRADE_MIN_STREAK=2

# ── Averaging down (server-side, triggered by position monitor) ──
AVG_DOWN_ENABLED=false
AVG_DOWN_ROE=-60
AVG_DOWN_MARGIN_USDT=2


{
  "name": "btc-liquidity-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "web": "node --max-old-space-size=12288 src/server.js",
    "btc": "node src/index.js BTC",
    "watch": "node src/index.js --watch",
    "combo-stats": "node scripts/combo-stats-by-day.js",
    "signal-eval": "node scripts/signal-eval-by-day.js",
    "daily-signal-report": "node scripts/daily-signal-report.js",
    "intraday-combos": "python3 scripts/intraday_combo_predictor.py --pretty",
    "shakeout-learn": "python3 scripts/shakeout_self_learning.py --paper-file data/shakeout-paper-trades.json --pretty",
    "recommended-learn": "python3 scripts/recommended_signal_learning.py --paper-file data/recommended-paper-trades.json --pretty",
    "archive:pump-paper": "node --max-old-space-size=12288 scripts/archive-pump-paper-store.mjs 100000",
    "test:br-like-rule": "node scripts/test-br-like-eval-rule.mjs",
    "analyze:pump": "node --max-old-space-size=2048 scripts/analyze-pump-performance.js",
    "analyze:pump-candle": "node --max-old-space-size=2048 scripts/analyze-pump-candle-context.mjs",
    "analyze:edge-short": "node scripts/analyze-edge-short-performance.js",
    "analyze:liquid": "node scripts/analyze-liquid-performance.js",
    "backtest:liquid-kill-zone": "node scripts/backtest-liquid-kill-zone.mjs",
    "analyze:shakeout-candle": "node scripts/analyze-shakeout-candle-performance.js",
    "analyze:decision-be": "node scripts/analyze-decision-break-even.mjs --compact",
    "test:liquid-auto-paper": "node scripts/test-liquid-scan-auto-paper.mjs",
    "test:pump-rule": "node scripts/test-pump-eval-rule.mjs",
    "test:shakeout-learn": "node scripts/test-shakeout-self-learning.mjs",
    "test:paper-page-learn": "node scripts/test-paper-page-self-learning.mjs",
    "test:recommended-learn": "node scripts/test-recommended-signal-learning.mjs",
    "test:decision-paper": "node scripts/test-intraday-decision-paper.mjs",
    "test:ema-pre-stage-rule": "node scripts/test-ema-pre-stage-candle-rule.mjs",
    "test:ema-stage-candle-rule": "node scripts/test-ema-stage-candle-rule.mjs",
    "test:shakeout-chase-shadow": "node scripts/test-shakeout-chase-shadow-rule.mjs",
    "test:shakeout-stage2": "node scripts/test-shakeout-stage2-rule.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.20.1"
  }
}
